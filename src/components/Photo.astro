---
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  class?: string;
  eager?: boolean;
}
const { name, class: className = '', eager = false } = Astro.props;
const photo = photos[name];
---
<!-- If the image fails to load, the brand-coloured frame shows instead of a broken icon. -->
<div class:list={['photo', className]}>
  <img
    src={photo.src}
    alt={photo.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    onerror="this.style.visibility='hidden'"
  />
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--blue) 0%, var(--sky) 100%);
    border-radius: 28px;
  }
  img { width: 100%; height: 100%; object-fit: cover; }
</style>
