---
import { withBase } from '../lib/url';

interface Props { height?: number; }
const { height = 60 } = Astro.props;
---
<img src={withBase('logo.svg')} alt="Steps Training & Events" class="logo" height={height} style={`height:${height}px`} />

<style>
  .logo { width: auto; display: block; }
</style>
