---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Wave from '../components/Wave.astro';
import { services, serviceGroups } from '../data/services';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Experience learning</span>
        <h1>Take bold steps.<br /><span class="accent">Grow with purpose.</span></h1>
        <p class="lead">
          Training, development, online learning and the digital tools behind them,
          helping people, teams and organizations build confidence, skills and momentum.
        </p>
        <div class="actions">
          <a class="btn" href={`${base}/services/`}>Explore our services</a>
          <a class="btn btn--ghost" href={`${base}/contact/`}>Book a call</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="false">
        <span class="dot"></span>
        <Photo name="beachTeam" class="hero-main" eager />
        <Photo name="groupGame" class="hero-small" eager />
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="section">
    <div class="container">
      <div class="intro">
        <span class="eyebrow">What we do</span>
        <h2>Helping people and organizations grow</h2>
      </div>
      {serviceGroups.map((g) => (
        <div class="service-group">
          <div class="group-head">
            <h3>{g.title}</h3>
            <p>{g.intro}</p>
          </div>
          <ul class="service-list">
            {services.filter((s) => s.group === g.id).map((s) => (
              <li>
                <a href={`${base}/services/#${s.id}`}>
                  <h4>{s.title}</h4>
                  <p>{s.short}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Team building -->
  <Wave direction="down" />
  <section class="section section--tint feature">
    <div class="container split">
      <div class="collage">
        <Photo name="valuesWorkshop" class="c-main" />
        <Photo name="legTie" class="c-float" />
      </div>
      <div>
        <span class="eyebrow">Team building</span>
        <h2>Teams that trust each other perform better</h2>
        <p class="lead">
          Fun, purposeful team building that gets people talking, laughing and working
          together, whether it's an afternoon activity or a full away day.
        </p>
        <ul class="ticks">
          <li>Indoor and outdoor activities for any group size</li>
          <li>Challenges designed around your team's goals</li>
          <li>Planned and run end to end, so you can just take part</li>
        </ul>
        <a class="btn" href={`${base}/services/#team-building`}>Plan a team day</a>
      </div>
    </div>
  </section>
  <Wave direction="up" />

  <!-- Corporate training -->
  <section class="section feature">
    <div class="container split split--flip">
      <div class="collage">
        <Photo name="missionVision" class="c-main alt" />
        <Photo name="participantGuides" class="c-float left" />
      </div>
      <div>
        <span class="eyebrow">Corporate training</span>
        <h2>Training people actually use the next day</h2>
        <p class="lead">
          Interactive sessions and programs for new starters, managers and leaders,
          built around your processes and your culture.
        </p>
        <ul class="ticks">
          <li>Leadership, customer service and sales training, with participant guides for every session</li>
          <li>Onboarding and SOP-based training for your teams</li>
          <li>On-site, off-site or blended delivery</li>
        </ul>
        <a class="btn" href={`${base}/services/#training`}>See training options</a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <Wave direction="down" />
  <section class="section section--tint">
    <div class="container">
      <div class="intro center">
        <span class="eyebrow">How it works</span>
        <h2>Three simple steps</h2>
      </div>
      <ol class="path">
        <li><span class="n">1</span><h3>Talk</h3><p>Tell us where you are and where you want to go.</p></li>
        <li><span class="n">2</span><h3>Plan</h3><p>We design the training, program or support that fits your goals.</p></li>
        <li><span class="n">3</span><h3>Step up</h3><p>We deliver, and you leave ready for the next step.</p></li>
      </ol>
    </div>
  </section>
  <Wave direction="up" />

  <!-- Gallery of real Steps events -->
  <section class="section">
    <div class="container">
      <div class="intro">
        <span class="eyebrow">From our events</span>
        <h2>Learning you can see</h2>
        <p class="lead">A few moments from recent Steps team building days and training sessions.</p>
      </div>
      <div class="gallery">
        <Photo name="eventBanner" class="g-wide" />
        <Photo name="groupGame" class="g-tall" />
        <Photo name="legTie" class="g-tall" />
        <Photo name="congaLine" class="g-wide" />
        <Photo name="beachGame" class="g-big" />
        <Photo name="valuesWorkshop" class="g-wide" />
        <Photo name="teamPlanning" class="g-sq" />
        <Photo name="coachingForms" class="g-sq g-last" />
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <Photo name="trainingMeeting" class="cta-bg" />
        <div class="cta-copy">
          <h2>Ready to take your next step?</h2>
          <p>Let's talk about what you want to achieve.</p>
          <a class="btn btn--light" href={`${base}/contact/`}>Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .accent { color: var(--blue); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .intro { max-width: 640px; margin-bottom: 40px; }
  .intro.center { margin-left: auto; margin-right: auto; text-align: center; }

  /* Hero */
  .hero { padding: 72px 0 96px; background: linear-gradient(180deg, #fff 0%, var(--sky-light) 100%); overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .hero-art { position: relative; min-height: 460px; }
  .hero-art :global(.hero-main) {
    position: absolute; inset: 0 0 60px 40px;
    border-radius: 200px 40px 200px 40px;
  }
  .hero-art :global(.hero-small) {
    position: absolute; left: 0; bottom: 0; width: 46%; aspect-ratio: 1;
    border-radius: 50%; border: 8px solid #fff; box-shadow: 0 16px 40px rgba(17,17,17,.15);
  }
  .dot {
    position: absolute; right: -30px; top: -30px; width: 140px; height: 140px; border-radius: 50%;
    background: repeating-linear-gradient(180deg, var(--sky) 0 14px, #fff 14px 20px);
    opacity: .9;
  }

  /* Service groups: title on the left, open two-column list on the right */
  .service-group {
    display: grid; grid-template-columns: 1fr 2fr; gap: 48px;
    padding: 40px 0; border-top: 1px solid var(--line);
  }
  .intro + .service-group { border-top: 0; padding-top: 8px; }
  .group-head h3 { font-size: 1.35rem; color: var(--blue); }
  .group-head p { color: var(--muted); margin: 0; }
  .service-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 32px; row-gap: 4px;
  }
  .service-list a {
    display: block; padding: 16px 16px 16px 36px; margin: 0 -16px; border-radius: 18px;
    text-decoration: none; color: inherit; transition: background .2s; position: relative;
  }
  .service-list a::before {
    content: ''; position: absolute; left: 14px; top: 24px; width: 10px; height: 10px; border-radius: 50%;
    background: var(--sky);
  }
  .service-list a:hover { background: var(--sky-light); }
  .service-list h4 { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 .2em; }
  .service-list a:hover h4 { color: var(--blue); }
  .service-list p { margin: 0; color: var(--muted); }
  @media (max-width: 820px) {
    .service-group { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 560px) {
    .service-list { grid-template-columns: 1fr; }
  }

  /* Photo collages */
  .collage { position: relative; padding-bottom: 60px; }
  .collage :global(.c-main) { aspect-ratio: 4 / 3.4; border-radius: 40px 160px 40px 40px; }
  .collage :global(.c-main.alt) { border-radius: 160px 40px 40px 40px; }
  .collage :global(.c-float) {
    position: absolute; right: -16px; bottom: 0; width: 44%; aspect-ratio: 1;
    border-radius: 50%; border: 8px solid var(--paper); box-shadow: 0 16px 40px rgba(17,17,17,.15);
  }
  .feature.section--tint .collage :global(.c-float) { border-color: var(--sky-light); }
  .collage :global(.c-float.left) { right: auto; left: -16px; }

  /* Steps path */
  .path { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; position: relative; text-align: center; }
  .path::before {
    content: ''; position: absolute; top: 28px; left: 16%; right: 16%;
    border-top: 3px dashed var(--sky);
  }
  .path li { position: relative; }
  .path .n {
    display: grid; place-items: center; width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 50%;
    background: var(--blue); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1.3rem;
    box-shadow: 0 0 0 8px var(--sky-light);
  }
  .path p { color: var(--muted); max-width: 28ch; margin: 0 auto; }

  /* CTA with photo */
  .cta-band { position: relative; border-radius: 40px; overflow: hidden; min-height: 340px; display: grid; place-items: center; text-align: center; }
  .cta-band :global(.cta-bg) { position: absolute; inset: 0; border-radius: 0; }
  .cta-band::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(18,58,117,.92), rgba(27,79,156,.75)); }
  .cta-copy { position: relative; z-index: 1; color: #fff; padding: 48px 24px; }
  .cta-copy p { font-size: 1.15rem; opacity: .9; margin-bottom: 1.5em; }
  :global(.btn--light) { background: #fff; color: var(--blue); border-color: #fff; }
  :global(.btn--light:hover) { background: var(--sky-light); border-color: var(--sky-light); color: var(--blue-dark); }

  /* Gallery: mixed sizes and soft corners (4 columns x 4 rows, every cell filled) */
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 200px; gap: 16px; }
  .gallery :global(.photo) { border-radius: 24px; height: 100%; }
  .gallery :global(.g-wide) { grid-column: span 2; }
  .gallery :global(.g-tall) { grid-row: span 2; }
  .gallery :global(.g-big) { grid-column: span 2; grid-row: span 2; border-radius: 24px 24px 24px 90px; }
  .gallery :global(.g-wide:first-child) { border-radius: 24px 90px 24px 24px; }
  .gallery :global(.g-last) { border-radius: 24px 24px 90px 24px; }
  @media (max-width: 900px) {
    .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 170px; }
    .gallery :global(.g-big) { grid-row: span 1; }
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-art { min-height: 340px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 48px 0 64px; }
    .dot { width: 90px; height: 90px; right: -10px; top: -20px; }
    .path { grid-template-columns: 1fr; gap: 28px; }
    .path::before { display: none; }
    .collage :global(.c-float) { right: 0; }
    .collage :global(.c-float.left) { left: 0; }
  }
</style>
