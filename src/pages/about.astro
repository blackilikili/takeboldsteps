---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About Steps Training & Events.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">About us</span>
      <h1>Every big change starts with a step</h1>
      <p class="lead">
        Steps Training &amp; Events helps individuals and organizations grow through
        training, development, better operations and well-run events.
      </p>
      <p><span class="placeholder-note">Placeholder:</span> add your story here: who you are, why you started Steps, and who you work with.</p>
    </div>
  </section>
  <section class="section section--tint">
    <div class="container">
      <h2>What we believe</h2>
      <div class="grid">
        <div class="card"><h3>Bold</h3><p>Growth happens just outside the comfort zone.</p></div>
        <div class="card"><h3>Practical</h3><p>Every session leaves you with something you can use tomorrow.</p></div>
        <div class="card"><h3>Personal</h3><p>We tailor everything to your people and your goals.</p></div>
      </div>
    </div>
  </section>
</Base>
