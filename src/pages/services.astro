---
import Base from '../layouts/Base.astro';
import { services } from '../data/services';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Services" description="Training, development, organizational development, SOPs, team building and operations services.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>How we can help</h1>
      <p class="lead">From training your people to tightening your operations, Steps supports every step of your growth.</p>
      <div class="grid list">
        {services.map((s, i) => (
          <article class="card" id={s.id}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
      <div class="cta">
        <h2>Not sure where to start?</h2>
        <p class="lead">Tell us what you're working on and we'll recommend the right step.</p>
        <a class="btn" href={`${base}/contact/`}>Enquire now</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .list { margin-top: 36px; }
  .card { scroll-margin-top: 96px; }
  .card h2 { font-size: 1.35rem; }
  .num { font-family: var(--font-display); font-weight: 900; color: var(--sky); font-size: 1.1rem; display: block; margin-bottom: 8px; }
  .cta { margin-top: 64px; padding: 40px; border-radius: var(--radius); background: var(--sky-light); text-align: center; }
  .cta .lead { margin: 0 auto 1.5em; }
  @media (max-width: 640px) { .cta { padding: 28px 20px; } }
</style>
