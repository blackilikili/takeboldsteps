---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ServiceArt from '../components/ServiceArt.astro';
import Wave from '../components/Wave.astro';
import { services, serviceGroups } from '../data/services';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Services" description="Training, development, team building, SOPs, operations, LMS and online courses, instructional design, websites, funnels and automations.">
  <section class="section page-head">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>How we can help</h1>
      <p class="lead">From training your people to building your online courses and the systems behind them, Steps supports every step of your growth.</p>
      {serviceGroups.map((g) => (
        <nav class="jump" aria-label={g.title}>
          <span class="jump-label">{g.title}</span>
          {services.filter((s) => s.group === g.id).map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        </nav>
      ))}
    </div>
  </section>

  {serviceGroups.map((g) => (
    <section class="rows" id={g.id}>
      <div class="container">
        <header class="group-head">
          <h2>{g.title}</h2>
          <p class="lead">{g.intro}</p>
        </header>
        {services.filter((s) => s.group === g.id).map((s, i) => (
          <article id={s.id} class:list={['split', 'row', { 'split--flip': i % 2 === 1 }]}>
            {s.photo
              ? <Photo name={s.photo} class={i % 2 === 0 ? 'shape-a' : 'shape-b'} />
              : <ServiceArt icon={s.icon!} class={i % 2 === 0 ? 'shape-a' : 'shape-b'} />}
            <div>
              <h3>{s.title}</h3>
              <p class="lead">{s.text}</p>
              <a class="more" href={`${base}/contact/`}>Ask about {s.title} &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <Wave direction="down" />
  <section class="section section--tint cta">
    <div class="container">
      <h2>Not sure where to start?</h2>
      <p class="lead">Tell us what you're working on and we'll recommend the right step.</p>
      <a class="btn" href={`${base}/contact/`}>Enquire now</a>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-bottom: 16px; }
  .jump { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 20px; }
  .jump-label {
    font-family: var(--font-display); font-weight: 700; font-size: .8rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--muted); margin-right: 4px;
  }
  .jump a {
    padding: .45em 1em; border-radius: 999px; background: var(--sky-light); color: var(--blue);
    text-decoration: none; font-weight: 600; font-size: .9rem;
  }
  .jump a:hover { background: var(--blue); color: #fff; }
  .rows { padding: 48px 0 40px; }
  .rows + .rows { border-top: 1px solid var(--line); }
  .group-head { max-width: 640px; }
  .group-head h2 { color: var(--blue); }
  .row { padding: 40px 0; scroll-margin-top: 96px; }
  .row :global(.photo), .row :global(.art) { aspect-ratio: 4 / 3; }
  .row :global(.shape-a) { border-radius: 40px 140px 40px 40px; }
  .row :global(.shape-b) { border-radius: 140px 40px 40px 40px; }
  .row h3 { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .more { font-weight: 700; font-family: var(--font-display); text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .cta { text-align: center; }
  .cta .lead { margin: 0 auto 1.5em; }
</style>
